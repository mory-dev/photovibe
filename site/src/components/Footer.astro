---
import { REPO_URL, ISSUES_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface-1">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-2.5 font-semibold">
        <img src="/logo.png" alt="" width="24" height="24" class="rounded-md" />
        Photovibe
      </div>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-text-muted">
        A free, open-source photo editor for Windows. Your photos stay on your machine.
      </p>
    </div>

    <nav aria-label="Product">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Product</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-text-muted hover:text-accent" href="/download">Download for Windows</a></li>
        <li><a class="text-text-muted hover:text-accent" href="/photoshop-alternative">Photoshop alternative</a></li>
        <li><a class="text-text-muted hover:text-accent" href="/docs/roadmap">Roadmap</a></li>
      </ul>
    </nav>

    <nav aria-label="Documentation">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Docs</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-text-muted hover:text-accent" href="/docs/getting-started">Getting started</a></li>
        <li><a class="text-text-muted hover:text-accent" href="/docs/tools-and-shortcuts">Tools &amp; shortcuts</a></li>
        <li><a class="text-text-muted hover:text-accent" href="/docs/build-from-source">Build from source</a></li>
        <li><a class="text-text-muted hover:text-accent" href="/docs/faq">FAQ</a></li>
      </ul>
    </nav>

    <nav aria-label="Project">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Project</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-text-muted hover:text-accent" href={REPO_URL} rel="noopener">Source on GitHub</a></li>
        <li><a class="text-text-muted hover:text-accent" href={ISSUES_URL} rel="noopener">Report an issue</a></li>
        <li><a class="text-text-muted hover:text-accent" href={`${REPO_URL}/blob/master/LICENSE`} rel="noopener">MIT licence</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-text-muted">
      © {year} Photovibe. Open source under the MIT licence. Not affiliated with Adobe.
      Photoshop is a trademark of Adobe Inc., used here only to describe compatibility of purpose.
    </p>
  </div>
</footer>
