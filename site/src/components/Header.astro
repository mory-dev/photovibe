---
import { REPO_URL } from '../consts';

const path = Astro.url.pathname.replace(/\.html$/, '');
const links = [
  { href: '/photoshop-alternative', label: 'vs Photoshop' },
  { href: '/docs', label: 'Docs' },
  { href: '/download', label: 'Download' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-surface-0/85 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-5" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <img src="/logo.png" alt="" width="26" height="26" class="rounded-md" />
      <span>Photovibe</span>
    </a>

    <div class="ml-auto flex items-center gap-1 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-1.5 transition-colors hover:bg-surface-2',
            isActive(link.href) ? 'text-accent' : 'text-text-muted hover:text-text',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={REPO_URL}
        rel="noopener"
        class="ml-1 flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-text-muted transition-colors hover:border-border-strong hover:text-text"
      >
        <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>
  </nav>
</header>
