---
import { RELEASES_URL, REPO } from '../consts';

interface Props {
  /** "primary" renders the filled accent button, "ghost" the outlined one. */
  variant?: 'primary' | 'ghost';
  label?: string;
  class?: string;
}

const { variant = 'primary', label = 'Download for Windows', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium transition-colors';
const styles =
  variant === 'primary'
    ? 'bg-accent text-[#1a1a1a] hover:bg-accent-hover'
    : 'border border-border-strong text-text hover:border-accent-muted hover:text-accent';
---

<a
  href={RELEASES_URL}
  rel="noopener"
  data-download-latest
  data-repo={REPO}
  class:list={[base, styles, className]}
>
  <svg viewBox="0 0 88 88" width="15" height="15" fill="currentColor" aria-hidden="true">
    <path d="M0 12.402 35.687 7.54v34.474H0zM40.146 6.9 87.535 0v41.527H40.146zM0 46.013h35.687v34.55L0 75.617zM40.146 46.458h47.389V88l-47.39-6.523z" />
  </svg>
  <span data-download-label>{label}</span>
</a>

<script>
  // Resolve the newest signed installer straight from the GitHub release, the
  // same source the desktop app's About dialog uses. Falls back to the
  // releases page, which is the correct destination before the first release.
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-download-latest]');
  if (links.length) {
    const repo = links[0].dataset.repo;
    fetch(`https://api.github.com/repos/${repo}/releases/latest`)
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((release: { tag_name: string; assets?: { name: string; browser_download_url: string }[] }) => {
        const exe = release.assets?.find((asset) => asset.name.toLowerCase().endsWith('.exe'));
        if (!exe) return;
        const version = release.tag_name.replace(/^v/, '');
        for (const link of links) {
          link.href = exe.browser_download_url;
          const label = link.querySelector('[data-download-label]');
          if (label && !link.dataset.keepLabel) label.textContent = `Download for Windows — v${version}`;
        }
        for (const slot of document.querySelectorAll('[data-latest-version]')) {
          slot.textContent = `v${version}`;
        }
      })
      .catch(() => {
        /* No release published yet: the releases page link already works. */
      });
  }
</script>
